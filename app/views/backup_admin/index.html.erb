<% if session[:backup_device].present? %><p><%= link_to "Resume Microsoft device sign-in", redmine_backup_device_path %></p><% end %>
<% html_title 'Backups' %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'backups', plugin: 'redmine_backup_plugin' %>
  <%= javascript_include_tag 'backups', plugin: 'redmine_backup_plugin', defer: true %>
<% end %>
<h2>Redmine backups</h2>
<p>Full database and file backups. Gateway excluded. Configuration is restricted to administrators.</p>
<% if @recovery %>
  <div class="flash warning">Recovery Mode: scheduling, uploads, cleanup and operational mail are stopped.</div>
  <%= button_to 'Activate this restored instance (leave schedule paused)', redmine_backup_activate_path, method: :post, data: { confirm: 'Confirm the old host is fenced and review the restored destinations before enabling scheduling.' } %>
<% end %>
<div class="backup-health">
  <% @health.each do |check| %><span class="<%= check['ok'] ? 'backup-ok' : 'backup-warning' %>"><%= check['name'] %>: <%= check['ok'] ? 'OK' : 'Needs attention' %></span><% end %>
</div>
<%= form_tag redmine_backup_settings_path, method: :post, class: 'tabular backup-settings' do %>
  <fieldset class="box"><legend>Schedule and local storage</legend>
    <p><label>Show status on homepage<br>(administrators only)</label><%= check_box_tag 'backup[show_homepage_status]', '1', @config['show_homepage_status'] %></p>
    <p><label>Enable schedule</label><%= check_box_tag 'backup[enabled]', '1', @config['enabled'] %></p>
    <% { 'time' => 'Daily time (HH:MM)', 'timezone' => 'Timezone', 'local_directory' => 'Local directory', 'pg_bin' => 'PostgreSQL bin directory' }.each do |key, label| %>
      <p><label><%= label %></label><%= text_field_tag "backup[#{key}]", @config[key], size: 65 %></p>
    <% end %>
    <p class="backup-hint">Default local directory: <%= @runtime.store.root %>. An existing state directory cannot be moved through this form; see the migration instructions.</p>
    <% { 'local_keep_dates' => ['Local successful dates to keep', 1, 3650], 'remote_keep_dates' => ['Default remote successful dates to keep', 1, 3650], 'disk_reserve_mb' => ['Minimum free disk reserve (MiB)', 64, 1048576], 'timeout_seconds' => ['Capture timeout (seconds)', 60, 172800] }.each do |key, details| %>
      <p><label><%= details[0] %></label><%= number_field_tag "backup[#{key}]", @config[key], min: details[1], max: details[2], required: true %></p>
    <% end %>
    <p><label>Packaging</label><%= select_tag 'backup[packaging]', options_for_select([['One backup folder', 'separate'], ['ZIP of backup folder', 'zip']], @config['packaging']) %></p>
    <p class="backup-hint">Each backup has its own folder. ZIP mode uploads one named archive directly in the destination, with the backup folder inside.</p>
    <p><label>Additional Redmine paths<br>(one per line)</label><%= text_area_tag 'backup[additional_paths]', @config['additional_paths'].join("\n"), rows: 5, cols: 65 %></p>
    <p class="backup-hint">Always include external environment files, SMTP state/key directories and service definitions required for recovery. Backups contain private credentials. The archive has no added encryption.</p>
  </fieldset>
  <% %w[primary secondary].each do |slot| %>
    <%= render partial: 'destination', locals: { slot: slot } %>
  <% end %>
  <fieldset class="box"><legend>Notifications through existing Redmine email</legend>
    <p><label>Recovery confirmation</label><%= check_box_tag 'backup[recovery_notifications]', '1', @config['recovery_notifications'] %></p>
    <p><label>Scheduled daily success summary</label><%= check_box_tag 'backup[daily_success_summary]', '1', @config['daily_success_summary'] %></p>
    <p><label>Users</label><%= select_tag 'backup[user_ids][]', options_from_collection_for_select(@users, :id, :name, @config['user_ids']), multiple: true, size: 6 %></p>
    <p><label>Groups</label><%= select_tag 'backup[group_ids][]', options_from_collection_for_select(@groups, :id, :lastname, @config['group_ids']), multiple: true, size: 5 %></p>
  </fieldset>
  <%= submit_tag 'Save settings' %>
<% end %>
<div class="backup-actions">
  <%= button_to 'Back up now', redmine_backup_actions_path(kind: 'backup'), method: :post %>
  <%= button_to 'Test notification', redmine_backup_actions_path(kind: 'test_notification'), method: :post %>
  <%= button_to 'Check setup', redmine_backup_actions_path(kind: 'health_check'), method: :post %>
</div>
<h3>Backup history</h3>
<p class="backup-hint">Retry backup is available only when the latest run has a failed upload. It takes a fresh full backup using current settings, then uploads it.</p>
<%= button_to 'Clear backup history', redmine_backup_clear_history_path(category: 'backups'), method: :post, data: { confirm: 'Clear completed backup history from this list? Backup files and retention records are preserved.' } %>
<table class="list backup-history"><thead><tr><th>Run</th><th>Date</th><th>Capture / upload result</th><th>Primary</th><th>Secondary</th><th>Actions</th></tr></thead><tbody>
  <% @runs.each do |run| %><tr>
    <td><%= run['id'] %><% if run['coverage_changed'] %><br><strong>Coverage changed</strong><% end %></td><td><%= run['date'] %></td>
    <td><%= run['captured'] ? 'Backup captured' : 'Backup not captured' %><br><strong><%= RedmineBackup::RunStatusService.upload_label(run) %></strong><%= run['local_deleted'] ? ' · local removed' : '' %><br><%= run['error'] %></td>
    <% %w[primary secondary].each do |slot| %><% state = run.fetch('destinations', {})[slot] %><td><%= state ? (state['verified'] ? 'Verified' : 'Pending / failed') : (slot == 'secondary' && !run['secondary_mode'] ? 'Disabled' : 'Not attempted') %><br><%= state && state['error'] %><br>Protection: <%= state && state['protection'] %><br>Cleanup: <%= state && state['cleanup'] %></td><% end %>
    <td><% if run['id'] == @latest_run_id && RedmineBackup::RunStatusService.retryable?(run) %><%= button_to 'Retry backup', redmine_backup_actions_path(kind: 'retry_upload', run_id: run['id']), method: :post %><% end %></td>
  </tr><% end %>
</tbody></table>
<details><summary>Recent audit history</summary><%= button_to 'Clear audit history', redmine_backup_clear_history_path(category: 'audit'), method: :post, data: { confirm: 'Clear audit history? The clearing action itself will be recorded.' } %><table class="list"><tbody><% @audit.each do |event| %><tr><td><%= event['at'] %></td><td><%= event['event'] %></td><td><%= event['actor'] %></td><td><%= event['run'] %></td></tr><% end %></tbody></table></details>
<details><summary>Notification delivery</summary><%= button_to 'Clear notification history', redmine_backup_clear_history_path(category: 'notifications'), method: :post, data: { confirm: 'Clear delivered and exhausted notification history? Alerts awaiting delivery are preserved.' } %><table class="list"><tbody><% @notifications.each do |event| %><tr><td><%= event['at'] %></td><td><%= event['code'] %></td><td><%= event['sent_at'] || event['delivery_status'] || 'Pending' %></td></tr><% end %></tbody></table></details>
