#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/redmine_backup'
require_relative '../lib/redmine_backup/backup_verification_service'

begin
  path = File.realpath(ARGV.fetch(0))
  if path.end_with?('.tar.gz')
    RedmineBackup::BackupVerificationService.verify_archive(path)
  else
    RedmineBackup::BackupVerificationService.verify_manifest(path)
  end
  puts 'Backup contents verified. A separate restore drill is still required.'
rescue StandardError
  warn 'Backup verification failed. Supply backup.tar.gz or an extracted manifest with all matching contents in private staging.'
  exit 1
end
